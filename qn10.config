# Kernel options the QN10 needs on top of the config of the running kernel.
# Every build merges this file, so an option set here cannot drop out of a
# config that one build inherits from the previous one.
#
# dm-crypt, for swap encrypted with a random key at each boot.
CONFIG_DM_CRYPT=m
# Security modules. The packaged config built AppArmor but left it out of the
# LSM list, so it never ran. Yama restricts ptrace. Landlock lets programs
# sandbox themselves.
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
