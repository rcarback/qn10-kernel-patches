+/*
+ * QCB: embedded controller at 0x76 on i2c9. DSDT: the EC generic event device
+ * \_SB.ECGE depends on ACPI IC10 (UID 10, Linux i2c9) and the PNP0C0B fans
+ * depend on ECGE, so fan control lives in the EC. DUMP: ACPI0013 (the GED)
+ * and one PNP0C0B fan are started, and ACPI IC10 is started. DSDT (live):
+ * FNTR = 0x0705, so FAN1 is _STA = 0xF and FAN2 is off; the second (SSD)
+ * fan is not exposed to ACPI. The QCB/CRD driver (qcom,hamoa-crd-ec,
+ * CONFIG_EC_QCOM_HAMOA=m in the image kernel) is the only Linux EC driver
+ * for this family, but whether the ASUS EC firmware (0206 in BIOS 0208)
+ * speaks the CRD protocol is unknown, and the DSDT GpioInt pin 768 (0x300)
+ * on GIO0, unchanged in the live table, lies in a virtual range: \_SB.GIO0
+ * declares 250 TLMM pins (GPIC) and bank bases GIC0..GIC3 = 0x100, 0x180,
+ * 0x280, 0x380, and the EC, ASUS HID, BT UART and codec interrupts use
+ * 0x280 + 64*n. No table in the DSDT maps those to TLMM pins. The GIO0 CIPR
+ * table does list TLMM 66 as PDC wake pin 186. No EC node is given, as on
+ * the A16; the earlier GUESS (the QCB node with TLMM 66) was removed for
+ * the RFC.
+ */
+&i2c9 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/* EC @ 0x76 */
+};
+
+/*
+ * DSDT (live): \_SB.PT7C (_HID ACPI000E, _STA 0xF) reads an external RTC
+ * at address 0x68 on ACPI IC11 (UID 0xB, Linux i2c10) and uses it as the
+ * ACPI time and alarm device. The part name is only "PT7C" (a Pericom
+ * prefix), so no child node is given.
+ */
+&i2c10 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+};
+
+/*
+ * DUMP: ACPI IC18 (UID 0x12, Linux i2c17) is started and carries the I2C
+ * HID device AUHD (ACPI 1025174B, address 0x3d, GpioInt TLMM 71, "I2C HID
+ * Device", started, hidi2c.inf). Its function is not documented. DSDT (live):
+ * the GpioInt is edge, active low, wake capable, with a pull-up; the
+ * level-low trigger follows the A16's hid-over-i2c nodes, the pull-up and
+ * wakeup-source follow the DSDT.
+ */
+&i2c17 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	hid@3d {
+		compatible = "hid-over-i2c";
+		reg = <0x3d>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 71 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&hid_int_b_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+};
