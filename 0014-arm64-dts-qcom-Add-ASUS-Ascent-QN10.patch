+	/* QCB, CRD, A16 */
+	wcn_sw_en: wcn-sw-en-state {
+		pins = "gpio94";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/* QCB, CRD, A16 */
+	wcn_wlan_bt_en: wcn-wlan-bt-en-state {
