+/*
+ * DUMP: ACPI I2C1 (1-based UID, Linux i2c0) is started and carries the I2C
+ * HID device AUHT (ACPI 0B054543, address 0x3a, "I2C HID Device", started).
+ * The same ASUS HID sits on the A16's i2c10. Its interrupt in the DSDT is
+ * GpioInt pin 0x2c0 on GIO0, which is outside the TLMM range and cannot be
+ * mapped, so no child node is given. The bus is enabled for i2cdetect.
+ */
+&i2c0 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+};
+
+/*
+ * DUMP: ACPI I2C6 (Linux i2c5) is started. It carries the PM8010 I2C PMIC
+ * (DSDT PML0 at address 0x08, "Power Management PML0", started; live DSDT
+ * _STA = 0x0B), the same device the CRD describes. DSDT: the PML0 I2C
+ * connection runs at 100 kHz, so the bus is set to 100 kHz (the CRD uses
+ * 400 kHz). The two eUSB2 redrivers are not I2C-enumerated by Windows, but
+ * the USB3 (usb_mp) ACPI device drives their reset lines GPIO 8 and GPIO 184
+ * in _PS0, which are the A16's two PTN3222 reset GPIOs. BOOT: with a
+ * PTN3222 at 0x4f described, usb_mp never probed; with no redriver node the
+ * lane 0 eUSB2 PHY works and every Type-A port enumerates. The redrivers are
+ * left to their power-on defaults and not described.
+ */
+&i2c5 {
+	clock-frequency = <100000>;
+
+	status = "okay";
+
+	/*
+	 * CRD node, DUMP presence. GUESS: reset GPIO 106 and what its LDOs feed
+	 * on the QN10. BOOT: off. The MFD part binds at 0x08, but every read of
+	 * the regulator block at 0x09 fails with -ENXIO (also when re-bound
+	 * minutes after boot), so regulator probe aborts at ldo1. Nothing on
+	 * the QN10 consumes these LDOs (the CRD uses them for cameras).
+	 */
+	pm8010: pmic@8 {
+		compatible = "qcom,pm8010-i2c";
+		reg = <0x8>;
+
+		status = "disabled";
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+
+		vdd-l1-l2-supply = <&vreg_l6p>;
+		vdd-l3-l4-supply = <&vreg_bob1_e0>;
+		vdd-l5-supply = <&vreg_bob1_e0>;
+		vdd-l6-supply = <&vreg_bob1_e0>;
+		vdd-l7-supply = <&vreg_bob1_e0>;
+
+		pinctrl-0 = <&pm8010_default>;
+		pinctrl-names = "default";
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8010 0 0 2>;
+
+		#thermal-sensor-cells = <0>;
+
+		regulators {
+			vreg_l1p: ldo1 {
+				regulator-name = "vreg_l1p";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			vreg_l2p: ldo2 {
+				regulator-name = "vreg_l2p";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			vreg_l3p: ldo3 {
+				regulator-name = "vreg_l3p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			vreg_l4p: ldo4 {
+				regulator-name = "vreg_l4p";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			vreg_l5p: ldo5 {
+				regulator-name = "vreg_l5p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			vreg_l6p: ldo6 {
+				regulator-name = "vreg_l6p";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
