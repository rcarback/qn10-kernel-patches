+&usb_2_qmpphy {
+	vdda-phy-supply = <&vreg_l4c_e1_0p72>;
+	vdda-pll-supply = <&vreg_l4f_e1_1p08>;
+	refgen-supply = <&vreg_l4f_e1_1p08>;
