+&tlmm {
+	/*
+	 * BOOT: with the A16 list (4-7, 10-11, 44-47, 65, 90) the system resets
+	 * while the TLMM driver probes, because the QN10 firmware blocks access
+	 * to more pins than that list names. Which extra pins are blocked is
+	 * not known, so this is an allow-list: every pin is reserved except
+	 * the ones this file uses (0-1, 8, 20-21, 36-37, 40-41, 56-59, 68-69,
+	 * 71, 86-87, 94, 106, 116-117, 119, 146-157, 184, 191). Boot-tested with
+	 * this exact list. Using a new pin means removing it from these ranges.
+	 */
+	gpio-reserved-ranges = <2 6>, <9 11>, <22 14>, <38 2>, <42 14>,
+			       <60 8>, <70 1>, <72 14>, <88 6>, <95 11>,
+			       <107 9>, <118 1>, <120 26>, <158 26>,
+			       <185 6>, <192 57>;
+
+	/*
+	 * DSDT (live): \_SB.USB3 (usb_mp) _PS0 drives GPIO 8 (E3RS) and then
+	 * GPIO 184 (E6RS) high, 10 ms apart. The firmware leaves 8 high; 184
+	 * is not driven on Linux. GUESS: E6RS enables the eUSB2 repeater or
+	 * hub supply on that path. The second-tier Genesys hub that Windows
+	 * listed below the first one (05e3:0610 rev 0656) is not board
+	 * hardware: it is the user's KVM. Its -71 failures continue with
+	 * this hog, and it works on a USB-C port (build/TODO.md).
+	 */
+	usb-mp-e6rs-hog {
+		gpio-hog;
+		gpios = <184 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "USB_MP_E6RS";
+	};
+
+	/* A14/A16: HDMI hot-plug detect */
+	edp0_hpd_default: edp0-hpd-default-state {
+		pins = "gpio119";
+		function = "edp0_hot";
+		bias-disable;
+	};
+
+	/* DUMP: AUHD GpioInt pin 71 */
+	hid_int_b_default: hid-int-b-default-state {
+		pins = "gpio71";
+		function = "gpio";
+		bias-pull-up;
+	};
+
+	/*
+	 * QCB, CRD, A16. DSDT (live): the PCIe plugin \_SB.QPPX lists the
+	 * PERST GPIOs per root complex: PCI3 143, PCI4 146, PCI5 152,
+	 * PCI6 149, PCI7 155, which match the pcie3b/4/5/6 states here.
+	 */
+	pcie3b_default: pcie3b-default-state {
+		clkreq-n-pins {
+			pins = "gpio156";
+			function = "pcie3b_clk";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio155";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		wake-n-pins {
+			pins = "gpio157";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	pcie4_default: pcie4-default-state {
+		clkreq-n-pins {
+			pins = "gpio147";
+			function = "pcie4_clk_req_n";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio146";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		wake-n-pins {
+			pins = "gpio148";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	/* QCB, CRD, A16 */
+	pcie5_default: pcie5-default-state {
+		clkreq-n-pins {
+			pins = "gpio153";
+			function = "pcie5_clk_req_n";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio152";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		wake-n-pins {
+			pins = "gpio154";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	/* QCB, CRD */
+	pcie6_default: pcie6-default-state {
+		clkreq-n-pins {
+			pins = "gpio150";
+			function = "pcie6_clk_req_n";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio149";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
