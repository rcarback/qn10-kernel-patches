+
+/*
+ * CRD: multiport controller, two eUSB2+SS lanes. DUMP: DSDT USB3 (QCOM0FEE,
+ * "USB3 eXtensible Host Controller", 0x0a400000) is the only xHCI host
+ * started; its root hub carries a Genesys 05e3:0625 SuperSpeed hub and
+ * 05e3:0610 USB 2.0 hub (rev 9406, one hub chip), with a second 05e3:0610
+ * (rev 0656) hub below, and every USB-A device enumerates there. Its _PS0
+ * raises GPIO 8 and GPIO 184, the two PTN3222 resets. DSDT (live): the root
+ * hub ports MP0 and MP2 (lane 0, USB 2.0 and SuperSpeed) return a
+ * connectable _UPC, MP1 and MP3 (lane 1) return not-connectable, so the
+ * hubs sit on lane 0 and lane 1 is unused even though its redriver is
+ * powered. BOOT: with the lane 1 PHYs disabled the xHCI reset times out
+ * (-110); with all four PHYs on, lane 0 runs at 480 Mbps and 10 Gbps and
+ * every Type-A port works. The lane 1 PHYs use the lane 0 supplies (GUESS).
+ */
+&usb_mp {
+	status = "okay";
+};
+
+&usb_mp_hsphy0 {
+	vdd-supply = <&vreg_l2h_e0_0p72>;
+	vdda12-supply = <&vreg_l4h_e0_1p2>;
+
+	status = "okay";
+};
