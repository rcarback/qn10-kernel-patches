+/*
+ * CRD: USB-C port 0. BOOT: UCSI does not start yet ("PPM init failed"), so
+ * no role is ever set and the Type-C controllers stay idle. Default them
+ * to host, which suits a desktop; UCSI can still switch roles once it
+ * works.
+ */
+&usb_0 {
+	role-switch-default-mode = "host";
+
+	status = "okay";
+};
