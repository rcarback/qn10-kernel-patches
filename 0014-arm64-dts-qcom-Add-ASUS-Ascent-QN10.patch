From 3a172dfb815a259ab22749a6781562982e0bec15 Mon Sep 17 00:00:00 2001
From: "Richard T. Carback III" <rick.carback@gmail.com>
Date: Thu, 19 Nov 2026 14:08:05 +0000
Subject: [PATCH 14/14] arm64: dts: qcom: Add ASUS Ascent QN10

The ASUS Ascent QN10 is a mini PC built on the Qualcomm Glymur platform
with a Snapdragon X2 Elite (X2E88100) SoC. Its firmware is derived from
the Qualcomm CRD reference design. The devicetree is based on
glymur-qcb.dts from qcom-next commit ae2606baf50f (tag
qcom-next-7.3-20261030). The Type-C and multiport USB, PM8010 and
SoundWire nodes come from the CRD, and the M.2 E-key connector from the
Zenbook A16.

Booting Linux on a QN10 confirms the USB ports, NVMe in both M.2 slots
(pcie5, and the Gen5 slot "G5" on pcie3b), the rear HDMI port on mdss_dp3
with audio, the WCD9378 headset codec on SoundWire, the GPU without a zap
shader, the firmware RTC through pmic-glink, and the video decoder (iris)
with its own IOMMU context at EL2. The Wi-Fi, Bluetooth and Ethernet
nodes follow the DSDT and the Windows device list of a QN10.

UCSI on the Type-C ports does not start yet. The PM8010 on I2C5 does not
respond and stays disabled. GPIO 184, which the firmware raises to power
USB 3, is hogged high. Each node notes its source: the DSDT, a Windows
device dump, a boot test, or the reference board file it comes from. The
embedded controller and the CDSP are not described.

Signed-off-by: Richard T. Carback III <rick.carback@gmail.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |    1 +
 .../boot/dts/qcom/glymur-asus-ascent-qn10.dts | 1560 +++++++++++++++++
 2 files changed, 1561 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/glymur-asus-ascent-qn10.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 5630ec5df..64b60bd67 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -19,6 +19,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= apq8096-ifc6640.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= eliza-cqs-evk-emmc.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= eliza-cqs-evk-ufs.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= eliza-mtp.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= glymur-asus-ascent-qn10.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-asus-zenbook-a14-ux3407na.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-asus-zenbook-a16-ux3607oa.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-crd.dtb
diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-ascent-qn10.dts b/arch/arm64/boot/dts/qcom/glymur-asus-ascent-qn10.dts
new file mode 100644
index 000000000..2a70d7977
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-ascent-qn10.dts
@@ -0,0 +1,1560 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+/dts-v1/;
+
+#include "glymur.dtsi"
+
+/* QCB: full CRD PMIC population. The A16 deletes two of these; the QN10 does not. */
+#include "pmcx0102.dtsi"        /* SPMI0: SID-2/3 SPMI1: SID-2/3 */
+#include "pmh0101.dtsi"         /* SPMI0: SID-1                  */
+#include "pmh0110-glymur.dtsi"  /* SPMI0: SID-5/7 SPMI1: SID-5   */
+#include "pmh0104-glymur.dtsi"  /* SPMI0: SID-8/9 SPMI1: SID-11  */
+#include "pmk8850.dtsi"         /* SPMI0: SID-0                  */
+#include "smb2370.dtsi"         /* SPMI2: SID-9/10/11            */
+
+/ {
+	/* DUMP: SMBIOS product "QN10", marketing name Ascent; "asus" prefix as the A16/A14 files */
+	model = "ASUS Ascent QN10";
+	compatible = "asus,ascent-qn10", "qcom,glymur";
+	chassis-type = "desktop";
+
+	aliases {
+		i2c0 = &i2c0;
+		i2c5 = &i2c5;
+		i2c9 = &i2c9;
+		i2c10 = &i2c10;
+		i2c17 = &i2c17;
+
+		serial0 = &uart21;	/* DUMP: SPCR/DBG2 console at 0x894000 (DSDT UARD, UID 0x16) */
+		serial1 = &uart14;	/* DUMP: Bluetooth UART, DSDT UR15 (UID 0x0f), QCA_SHB\UART_H4_CLG */
+	};
+
+	/* QCB */
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/* QCB */
+	clocks {
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+
+	/*
+	 * The rear HDMI 2.1 port hangs off mdss_dp3 (see &mdss_dp3 below)
+	 * through a DP-to-HDMI bridge that needs no driver: the dump has no
+	 * I2C bridge device, and AUX/EDID reach the monitor directly.
+	 */
+
+	/*
+	 * Three USB4 Type-C ports and no battery. CRD/A16 shape for two
+	 * connectors, HP for the third. DSDT (live): the UCSI device \_SB.UCS0
+	 * names a Parade PS8830 retimer for each of the three ports (RTM0..2);
+	 * on Glymur the firmware drives the retimers, so no DT node exists for
+	 * them (the X1E boards describe theirs on I2C). DUMP: URS0/URS1/URS2 (QCOM0F8B/0F8C/
+	 * 0FED) at 0x0a600000/0x0a800000/0x0a000000 are all started, that is
+	 * usb_0/usb_1/usb_2; UCSI (USBC000, QCOM0F9D), PMIC glink (QCOM0F8E)
+	 * and the USB4 host router (QCOM0C6D, no Linux driver) are started.
+	 * GUESS: the mapping of controller to physical port.
+	 */
+	pmic-glink {
+		compatible = "qcom,glymur-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * BOOT: the RTC is the firmware clock behind pmic_glink
+		 * (rtc-qcom-glink, 7.4). It reads 1980-01-06 plus uptime until
+		 * set; without this flag the driver refuses RTC_SET_TIME.
+		 */
+		allow-set-time;
+
+		/* GUESS: front USB-C, left */
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_0_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_0_qmpphy_out>;
+					};
+				};
+			};
+		};
+
+		/* GUESS: front USB-C, right */
+		connector@1 {
+			compatible = "usb-c-connector";
+			reg = <1>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in1: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in1: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+			};
+		};
+
+		/* GUESS: rear USB-C */
+		connector@2 {
+			compatible = "usb-c-connector";
+			reg = <2>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in2: endpoint {
+						remote-endpoint = <&usb_2_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in2: endpoint {
+						remote-endpoint = <&usb_2_qmpphy_out>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * Not described: the CRD VREG_MISC_3P3 rail (pmh0110_f_e0 gpio6). It feeds
+	 * the CRD touchpad, keyboard and touchscreen, which the QN10 lacks, so the
+	 * earlier always-on copy of it was removed for the RFC.
+	 */
+
+	/* QCB, CRD and A16: identical on every Glymur board. Feeds the Gen4 M.2 slot. */
+	vreg_nvme: regulator-nvme {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_NVME_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&pmh0101_gpios 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&nvme_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	/*
+	 * CRD74: 3.3 V rail of the second M.2 slot (label "G5", pcie3b).
+	 * BOOT: with this rail and the pcie3b nodes below, a WD SN850X in the
+	 * G5 slot enumerates (7.4.0-rc1, 2026-11-16).
+	 */
+	vreg_nvmesec: regulator-nvmesec {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_NVME_SEC_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&pmh0110_f_e1_gpios 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&nvme_sec_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	/* QCB, CRD and A16: identical on every Glymur board */
+	vreg_wcn_3p3: regulator-wcn-3p3 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_WCN_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&tlmm 94 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&wcn_sw_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	/* A16 */
+	reserved-memory {
+		linux,cma {
+			compatible = "shared-dma-pool";
+			size = <0x0 0x10000000>;
+			reusable;
+			linux,cma-default;
+		};
+	};
+
+	/*
+	 * CRD WCD9378 links only. DUMP: the only SoundWire peripheral is
+	 * SDCA MAN_0217 PART_0110 (WCD9378C) at ADR_03 on LID_01 with
+	 * headset render and capture endpoints (ASUS subsystem 1043:8940).
+	 * There are no WSA amplifiers and no DMIC devices, so the WSA and VA
+	 * links of the CRD are left out. DSDT (live): the codec device
+	 * \_SB.ASCD is _STA = 0xF and owns GpioIo 191 (reset) and 32; the
+	 * ACX device \_SB.AUCD owns GpioIo 204 and 205 (purpose unknown).
+	 * The card model string follows the A16 pattern.
+	 */
+	sound {
+		compatible = "qcom,glymur-sndcard";
+		model = "GLYMUR-ASUS-Ascent-QN10";
+
+		audio-routing = "IT 41 Playback", "HPHL_OUT",
+				"IT 41 Playback", "HPHR_OUT",
+				/* CRD: bridge the TX macro input to the WCD capture terminal */
+				"TX SWR_INPUT1", "OT 36 Capture";
+
+		/*
+		 * CRD: swr2 is the bus master and swr1 its lane provider, so
+		 * both DAI links reference &swr2 (cell 0 dout, cell 1 din).
+		 */
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&wcd9378c 0>, <&swr2 0>, <&lpass_rxmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			cpu {
+				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+			};
+
+			codec {
+				sound-dai = <&wcd9378c 18>, <&swr2 1>, <&lpass_txmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		/*
+		 * Rear HDMI (mdss_dp3). The DP audio interface index follows the
+		 * DAI ID, so dp3 needs DISPLAY_PORT_RX_3; the QN10 topology
+		 * (GLYMUR-ASUS-Ascent-QN10-tplg.bin) carries that graph on
+		 * MultiMedia7. BOOT: jack, ELD (2 ch LPCM) and playback.
+		 */
+		displayport-3-dai-link {
+			link-name = "DisplayPort3 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp3>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
+	/*
+	 * A16: generic M.2 E-key connector. DUMP: the module is a Foxconn
+	 * NCM820A (FastConnect C7700 / QCC2072, PCI 17cb:1112 subsystem
+	 * 105b:e14f, qcwlancol8480.inf), not the WCN7850 (17cb:1107) that the
+	 * QCB and CRD describe, so the QCB wcn7850-pmu node and its pci17cb,1107
+	 * child are deliberately not used. The Bluetooth side is a UART H4
+	 * device ("FastConnect C7700 NCM820A Bluetooth", qcbluetooth8480.inf)
+	 * on uart14 (QCOM0F6B).
+	 */
+	wlan-connector {
+		compatible = "pcie-m2-e-connector";
+		vpcie3v3-supply = <&vreg_wcn_3p3>;
+		vpcie1v8-supply = <&vreg_l15b_e0_1p8>;
+
+		w-disable1-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+		w-disable2-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&wcn_wlan_bt_en>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				m2_e_pcie_ep: endpoint {
+					remote-endpoint = <&pcie4_port0_ep>;
+				};
+			};
+
+			port@3 {
+				reg = <3>;
+
+				m2_e_uart_ep: endpoint {
+					remote-endpoint = <&uart14_ep>;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * QCB: the RPMh regulator table of the CRD family (B_E0, C_E1, F_E0, F_E1,
+ * H_E0). The A16 table was considered, but the A16 removes the H_E0 PMIC and
+ * substitutes C_E0 rails, which does not fit a CRD-derived firmware. The A16
+ * C_E0 block, once appended here without a consumer, was removed for the
+ * RFC. GUESS: the QN10 keeps the CRD rail plan.
+ */
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pmh0101-rpmh-regulators";
+		qcom,pmic-id = "B_E0";
+
+		vreg_bob1_e0: bob1 {
+			regulator-name = "vreg_bob1_e0";
+			regulator-min-microvolt = <2200000>;
+			regulator-max-microvolt = <4224000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+
+		vreg_bob2_e0: bob2 {
+			regulator-name = "vreg_bob2_e0";
+			regulator-min-microvolt = <2540000>;
+			regulator-max-microvolt = <3600000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+
+		vreg_l1b_e0_1p8: ldo1 {
+			regulator-name = "vreg_l1b_e0_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2b_e0_2p9: ldo2 {
+			regulator-name = "vreg_l2b_e0_2p9";
+			regulator-min-microvolt = <2904000>;
+			regulator-max-microvolt = <2904000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l7b_e0_2p79: ldo7 {
+			regulator-name = "vreg_l7b_e0_2p79";
+			regulator-min-microvolt = <2790000>;
+			regulator-max-microvolt = <2792000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * DSDT (live): \_SB.USB3 and \_SB.USB4 vote LDO8_B at 3.072 V,
+		 * \_SB.GPU0 (display) at 3.3 V; A14/A16/Yoga use 3.304 V (eUSB2
+		 * redriver vdd3v3). The QCB/CRD 1.504 V was applied at boot
+		 * (min == max) even with no consumer. BOOT: at 3.304 V the rear
+		 * HDMI (mdss_dp3) trains and shows 3840x2160.
+		 */
+		vreg_l8b_e0_3p3: ldo8 {
+			regulator-name = "vreg_l8b_e0_3p3";
+			regulator-min-microvolt = <3304000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9b_e0_2p7: ldo9 {
+			regulator-name = "vreg_l9b_e0_2p7";
+			regulator-min-microvolt = <2704000>;
+			regulator-max-microvolt = <2704000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l10b_e0_1p8: ldo10 {
+			regulator-name = "vreg_l10b_e0_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11b_e0_1p2: ldo11 {
+			regulator-name = "vreg_l11b_e0_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l12b_e0_1p14: ldo12 {
+			regulator-name = "vreg_l12b_e0_1p14";
+			regulator-min-microvolt = <1144000>;
+			regulator-max-microvolt = <1144000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l15b_e0_1p8: ldo15 {
+			regulator-name = "vreg_l15b_e0_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			/* A16: reference voltage for many undescribed components */
+			regulator-always-on;
+		};
+
+		vreg_l17b_e0_2p4: ldo17 {
+			regulator-name = "vreg_l17b_e0_2p4";
+			regulator-min-microvolt = <2400000>;
+			regulator-max-microvolt = <2700000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l18b_e0_1p2: ldo18 {
+			regulator-name = "vreg_l18b_e0_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			/* A16: reference voltage for many undescribed components */
+			regulator-always-on;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pmcx0102-rpmh-regulators";
+		qcom,pmic-id = "C_E1";
+
+		vreg_l1c_e1_0p82: ldo1 {
+			regulator-name = "vreg_l1c_e1_0p82";
+			regulator-min-microvolt = <832000>;
+			regulator-max-microvolt = <832000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2c_e1_1p14: ldo2 {
+			regulator-name = "vreg_l2c_e1_1p14";
+			regulator-min-microvolt = <1144000>;
+			regulator-max-microvolt = <1144000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3c_e1_0p89: ldo3 {
+			regulator-name = "vreg_l3c_e1_0p89";
+			regulator-min-microvolt = <890000>;
+			regulator-max-microvolt = <980000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l4c_e1_0p72: ldo4 {
+			regulator-name = "vreg_l4c_e1_0p72";
+			regulator-min-microvolt = <720000>;
+			regulator-max-microvolt = <720000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
