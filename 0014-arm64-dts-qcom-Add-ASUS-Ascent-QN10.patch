+};
+
+/* CRD: USB-C port 1 */
+&usb_1 {
+	role-switch-default-mode = "host";
+
+	status = "okay";
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in1>;
